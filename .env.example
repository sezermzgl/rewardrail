# Stellar testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Account secrets (generated by packages/scripts, never commit real values)
ISSUER_SECRET=
SPONSOR_SECRET=
VALIDATOR_SECRET=
ADVERTISER_SECRET=
PUBLISHER_SECRET=

# Deployed addresses
ESCROW_CONTRACT_ID=
TUSDC_SAC_ID=

# Anchor. The SDF reference anchor (SEP-24, SRT) is the default; the Turkish
# TRY ramp below is SEP-6 and settles in Circle's testnet USDC.
# ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
# ANCHOR_ASSET_CODE=USDC
# ANCHOR_PROTOCOL=sep6          # force one when an anchor publishes both

# Deployment. Required once NODE_ENV=production: the write endpoints hold the
# issuer key, so an unguarded public URL is someone else's demo to end. Reads
# stay open either way. The web app sends it as the x-rewardrail-key header.
WRITE_SECRET=

# Secrets for a host with no filesystem. Each is the same JSON the setup
# scripts write; the local files are used when these are unset.
# VALIDATOR_KEYS={"rewardIssuer":"S...","...":"..."}
# VALIDATOR_PLAYERS={"honest":"S...","fraudster":"S..."}
# VALIDATOR_DEPLOYED={"escrow":"C...","anchorSac":"C..."}

# Demo configuration
# The campaign every screen in a walkthrough points at.
DEMO_CAMPAIGN_ID=0
CLAWBACK_WINDOW_SECONDS=60
TRUST_TIER_MIN_AGE_DAYS=7
TRUST_TIER_MIN_TASKS=5
